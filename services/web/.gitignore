node_modules/
dist/
openapi.yaml
*.tsbuildinfo

# The workbench's built output. Regenerated by `pnpm run build-workbench`; the copies kept
# as a record of how a screen looked live under design-previews/_live/, not here.
storybook-static/

# Playwright run artifacts, all regenerated by every run. e2e/screenshots/ used to be
# committed deliberately, as evidence linked from docs/tasks/*.md -- reversed 2026-09-12
# (docs/decisions.md): every run rewrites the whole set (any UI change touches most of
# them) and any ad-hoc script can drop new ones straight into the shared folder, so the
# directory grew unboundedly. A task's evidence is pasted into the task file itself now.
test-results/
playwright-report/
e2e/screenshots/
