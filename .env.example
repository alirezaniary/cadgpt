# Local development. The compose stack maps Postgres to 5433 and Redis to 6380 on the
# host, so this file works whether or not you already run either service yourself.
DJANGO_SECRET_KEY=generate-me-with-openssl-rand-hex-32
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://cadgpt:cadgpt@localhost:5433/cadgpt
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1
