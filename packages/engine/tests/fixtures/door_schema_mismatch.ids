<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
	<ids:info>
		<ids:title>Door name recorded (wrong schema)</ids:title>
		<ids:description>T-0037 review F1: otherwise identical to door_name_recorded.ids -- same applicability, same requirement, and three_doors.ifc genuinely satisfies it (matched=3, requirement passed=3/failed=0/indeterminate=0) -- except this specification declares ifcVersion="IFC2X3" only. three_doors.ifc is IFC4, so the specification's own applicability could not be established (SCHEMA_MISMATCH, UNDETERMINED_APPLICABILITY) even though ifctester still matched real entities and evaluated the facet against them for real. This is the case an unconditional PASS pill on the requirement would misrepresent: three real doors really do have a Name, but whether this rule even applies to an IFC4 model was never established.</ids:description>
		<ids:date>2026-09-10</ids:date>
	</ids:info>
	<ids:specifications>
		<ids:specification ifcVersion="IFC2X3" name="Door name recorded (wrong schema)">
			<ids:applicability maxOccurs="unbounded">
				<ids:entity>
					<ids:name>
						<ids:simpleValue>IFCDOOR</ids:simpleValue>
					</ids:name>
				</ids:entity>
			</ids:applicability>
			<ids:requirements>
				<ids:attribute cardinality="required">
					<ids:name>
						<ids:simpleValue>Name</ids:simpleValue>
					</ids:name>
				</ids:attribute>
			</ids:requirements>
		</ids:specification>
	</ids:specifications>
</ids:ids>
