{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadgpt.local/schemas/regulations/structural-bundle-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_key", "source_sha256", "graph_sha256", "sequence", "start_pdf_page", "end_pdf_page", "continuation_edges", "pages", "formulas", "tables", "units", "abbreviations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_key": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "sequence": {"type": "integer", "minimum": 1},
    "start_pdf_page": {"type": "integer", "minimum": 1},
    "end_pdf_page": {"type": "integer", "minimum": 1},
    "continuation_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "formulas": {"type": "array", "items": {"$ref": "#/$defs/formula"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "abbreviations": {"type": "array", "items": {"$ref": "#/$defs/abbreviation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.?(/|$)|\\\\)"}},
    "bbox": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}, {"type": "integer"}], "items": false, "minItems": 4, "maxItems": 4},
    "idList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "spanIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "state": {"enum": ["ready", "needs_review", "failed"]},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes", "media_type"],
      "properties": {
        "role": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["page_id", "pdf_page", "printed_page_label", "state", "reason_codes", "source_artifacts", "node_ids", "formula_ids", "unit_ids", "abbreviation_ids", "table_ids", "blocks"],
      "properties": {
        "page_id": {"type": "string", "minLength": 1}, "pdf_page": {"type": "integer", "minimum": 1},
        "printed_page_label": {"type": ["string", "null"]}, "state": {"$ref": "#/$defs/state"},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "source_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "node_ids": {"$ref": "#/$defs/idList"}, "formula_ids": {"$ref": "#/$defs/idList"},
        "unit_ids": {"$ref": "#/$defs/idList"}, "abbreviation_ids": {"$ref": "#/$defs/idList"},
        "table_ids": {"$ref": "#/$defs/idList"},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "kind", "source_order", "pdf_page", "parent_id", "children_ids", "printed_label", "source_kind", "source_span_ids", "raw_text", "normalized_text", "bbox", "state"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1},
        "source_order": {"type": "integer", "minimum": 1}, "pdf_page": {"type": "integer", "minimum": 1},
        "parent_id": {"type": ["string", "null"]}, "children_ids": {"$ref": "#/$defs/idList"},
        "printed_label": {"type": ["string", "null"]}, "source_kind": {"enum": ["native", "ocr"]},
        "source_span_ids": {"$ref": "#/$defs/spanIds"}, "raw_text": {"type": "string", "minLength": 1},
        "normalized_text": {"type": "string"},
        "alternate_source_span_ids": {"$ref": "#/$defs/idList"}, "alternate_raw_text": {"type": "string"},
        "bbox": {"$ref": "#/$defs/bbox"}, "state": {"$ref": "#/$defs/state"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from_page_id", "to_page_id", "from_pdf_page", "to_pdf_page", "reason"],
      "properties": {
        "from_page_id": {"type": "string", "minLength": 1}, "to_page_id": {"type": "string", "minLength": 1},
        "from_pdf_page": {"type": "integer", "minimum": 1}, "to_pdf_page": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "crop": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}}
    },
    "formula": {
      "type": "object", "additionalProperties": false,
      "required": ["formula_id", "pdf_page", "source_kind", "source_span_ids", "bbox", "crop", "raw_transcription", "unicode", "latex", "presentation_mathml", "content_mathml", "parse_status", "diagnostics", "unresolved_glyphs"],
      "properties": {
        "formula_id": {"type": "string", "minLength": 1}, "pdf_page": {"type": "integer", "minimum": 1}, "source_kind": {"enum": ["native", "ocr"]},
        "source_span_ids": {"$ref": "#/$defs/spanIds"}, "bbox": {"$ref": "#/$defs/bbox"}, "crop": {"$ref": "#/$defs/crop"},
        "raw_transcription": {"type": "string"}, "unicode": {"type": "string"}, "latex": {"type": ["string", "null"]},
        "presentation_mathml": {"type": "string", "minLength": 1}, "content_mathml": {"type": ["string", "null"]},
        "parse_status": {"enum": ["validated", "needs_review", "rejected"]}, "diagnostics": {"type": "array", "items": {"type": "string"}}, "unresolved_glyphs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["table_id", "pdf_page", "source_span_ids", "reasons", "rows", "state", "diagnostics"],
      "properties": {
        "table_id": {"type": "string", "minLength": 1}, "pdf_page": {"type": "integer", "minimum": 1}, "source_span_ids": {"$ref": "#/$defs/spanIds"},
        "reasons": {"type": "array", "items": {"type": "string"}}, "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
        "state": {"$ref": "#/$defs/state"}, "diagnostics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "pdf_page", "source_kind", "source_span_ids", "bbox", "printed", "ucum_code", "mapping_status"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1}, "pdf_page": {"type": "integer", "minimum": 1}, "source_kind": {"enum": ["native", "ocr"]},
        "source_span_ids": {"$ref": "#/$defs/spanIds"}, "bbox": {"$ref": "#/$defs/bbox"}, "printed": {"type": "string", "minLength": 1},
        "ucum_code": {"type": ["string", "null"]}, "mapping_status": {"enum": ["mapped", "unknown"]}
      }
    },
    "abbreviation": {
      "type": "object", "additionalProperties": false,
      "required": ["abbreviation_id", "pdf_page", "source_kind", "source_span_ids", "bbox", "printed"],
      "properties": {
        "abbreviation_id": {"type": "string", "minLength": 1}, "pdf_page": {"type": "integer", "minimum": 1}, "source_kind": {"enum": ["native", "ocr"]},
        "source_span_ids": {"$ref": "#/$defs/spanIds"}, "bbox": {"$ref": "#/$defs/bbox"}, "printed": {"type": "string", "minLength": 1}
      }
    }
    ,"row": {
      "type": "object", "additionalProperties": false,
      "required": ["row_index", "cells"],
      "properties": {"row_index": {"type": "integer", "minimum": 0}, "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}}
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_id", "column_index", "row_span", "column_span", "raw_text", "source_span_ids"],
      "properties": {
        "cell_id": {"type": "string", "minLength": 1}, "column_index": {"type": "integer", "minimum": 0},
        "row_span": {"type": "integer", "minimum": 1}, "column_span": {"type": "integer", "minimum": 1},
        "raw_text": {"type": "string"}, "source_span_ids": {"$ref": "#/$defs/spanIds"}
      }
    }
  }
}
