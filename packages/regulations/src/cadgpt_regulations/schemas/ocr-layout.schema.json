{
  "$defs": {
    "attempt": {
      "additionalProperties": false,
      "properties": {
        "line_count": {
          "minimum": 0,
          "type": "integer"
        },
        "mean_confidence_permyriad": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "page_segmentation_mode": {
          "enum": [
            3,
            6
          ]
        },
        "token_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "page_segmentation_mode",
        "token_count",
        "line_count",
        "mean_confidence_permyriad"
      ],
      "type": "object"
    },
    "bbox": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "coordinateSpace": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "minimum": 1,
          "type": "integer"
        },
        "origin": {
          "const": "top_left"
        },
        "unit": {
          "const": "pixel"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "unit",
        "origin",
        "width",
        "height"
      ],
      "type": "object"
    },
    "engine": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array"
        },
        "det_model": {
          "minLength": 1,
          "type": "string"
        },
        "device": {
          "minLength": 1,
          "type": "string"
        },
        "dpi": {
          "maximum": 600,
          "minimum": 72,
          "type": "integer"
        },
        "languages": {
          "const": [
            "fas",
            "eng"
          ]
        },
        "models": {
          "items": {
            "$ref": "#/$defs/model"
          },
          "maxItems": 3,
          "minItems": 0,
          "type": "array"
        },
        "name": {
          "enum": [
            "paddleocr"
          ]
        },
        "page_segmentation_mode": {
          "enum": [
            0,
            3,
            6
          ]
        },
        "raw_result": {
          "type": "object"
        },
        "rec_model": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "languages",
        "page_segmentation_mode",
        "dpi",
        "models",
        "attempts"
      ],
      "type": "object"
    },
    "line": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "confidence_permyriad": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "raw_text": {
          "minLength": 1,
          "type": "string"
        },
        "span_id": {
          "minLength": 1,
          "type": "string"
        },
        "token_span_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "span_id",
        "raw_text",
        "bbox",
        "confidence_permyriad",
        "token_span_ids"
      ],
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "language": {
          "enum": [
            "fas",
            "eng",
            "osd"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "language",
        "sha256",
        "bytes"
      ],
      "type": "object"
    },
    "preprocessing": {
      "additionalProperties": false,
      "properties": {
        "operations": {
          "items": {
            "enum": [
              "grayscale",
              "otsu_global"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "source_render_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "source_render_sha256",
        "operations"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "token": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "block": {
          "minimum": 0,
          "type": "integer"
        },
        "confidence_permyriad": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "minimum": 0,
          "type": "integer"
        },
        "paragraph": {
          "minimum": 0,
          "type": "integer"
        },
        "raw_text": {
          "minLength": 1,
          "type": "string"
        },
        "span_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "raw_text",
        "bbox",
        "confidence_permyriad",
        "block",
        "paragraph",
        "line"
      ],
      "type": "object"
    }
  },
  "$id": "https://cadgpt.local/schemas/regulation-ocr-layout-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coordinate_space": {
      "$ref": "#/$defs/coordinateSpace"
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/line"
      },
      "type": "array"
    },
    "page_id": {
      "pattern": "^sha256:[0-9a-f]{64}:page:[0-9]{6}$",
      "type": "string"
    },
    "preprocessing": {
      "$ref": "#/$defs/preprocessing"
    },
    "raw_text": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "tokens": {
      "items": {
        "$ref": "#/$defs/token"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "page_id",
    "coordinate_space",
    "engine",
    "preprocessing",
    "raw_text",
    "tokens",
    "lines"
  ],
  "type": "object"
}
