{
  "$defs": {
    "acquisitionIdentity": {
      "additionalProperties": false,
      "properties": {
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "receipt_sha256"
      ],
      "type": "object"
    },
    "catalogIdentity": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "catalog_id",
        "schema_version",
        "sha256",
        "provenance"
      ],
      "type": "object"
    },
    "classificationCounts": {
      "additionalProperties": false,
      "properties": {
        "blank": {
          "minimum": 0,
          "type": "integer"
        },
        "degraded_photo": {
          "minimum": 0,
          "type": "integer"
        },
        "image_scan": {
          "minimum": 0,
          "type": "integer"
        },
        "mixed": {
          "minimum": 0,
          "type": "integer"
        },
        "native_text": {
          "minimum": 0,
          "type": "integer"
        },
        "suspect_native": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "blank",
        "native_text",
        "suspect_native",
        "image_scan",
        "mixed",
        "degraded_photo"
      ],
      "type": "object"
    },
    "configuration": {
      "additionalProperties": false,
      "properties": {
        "paddle_device": {
          "minLength": 1,
          "type": "string"
        },
        "page_timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        },
        "parser_boundary": {
          "const": "crop_box"
        },
        "render_dpi": {
          "maximum": 600,
          "minimum": 72,
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "thresholds": {
          "additionalProperties": false,
          "properties": {
            "blank_ink_coverage_permyriad": {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            "minimum_native_nonspace_chars": {
              "minimum": 0,
              "type": "integer"
            },
            "mixed_bitmap_coverage_permyriad": {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            "scan_bitmap_coverage_permyriad": {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "minimum_native_nonspace_chars",
            "mixed_bitmap_coverage_permyriad",
            "scan_bitmap_coverage_permyriad",
            "blank_ink_coverage_permyriad"
          ],
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "render_dpi",
        "page_timeout_seconds",
        "parser_boundary",
        "thresholds",
        "sha256"
      ],
      "type": "object"
    },
    "document": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog_key": {
          "minLength": 1,
          "type": "string"
        },
        "catalog_order": {
          "minimum": 1,
          "type": "integer"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/page"
          },
          "type": "array"
        },
        "pdf_page_count": {
          "minimum": 1,
          "type": "integer"
        },
        "source_bytes": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "catalog_key",
        "catalog_order",
        "source_sha256",
        "source_bytes",
        "pdf_page_count",
        "artifact_path",
        "pages"
      ],
      "type": "object"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "diagnostic": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "diagnostic"
      ],
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "bitmap_count": {
          "minimum": 0,
          "type": "integer"
        },
        "bitmap_coverage_permyriad": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "ink_coverage_permyriad": {
          "oneOf": [
            {"maximum": 10000, "minimum": 0, "type": "integer"},
            {"type": "null"}
          ]
        },
        "native_char_cells": {
          "minimum": 0,
          "type": "integer"
        },
        "native_line_cells": {
          "minimum": 0,
          "type": "integer"
        },
        "native_nonspace_chars": {
          "minimum": 0,
          "type": "integer"
        },
        "native_word_cells": {
          "minimum": 0,
          "type": "integer"
        },
        "render_height_pixels": {
          "oneOf": [{"minimum": 1, "type": "integer"}, {"type": "null"}]
        },
        "render_width_pixels": {
          "oneOf": [{"minimum": 1, "type": "integer"}, {"type": "null"}]
        },
        "shape_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "native_char_cells",
        "native_nonspace_chars",
        "native_word_cells",
        "native_line_cells",
        "bitmap_count",
        "shape_count",
        "bitmap_coverage_permyriad",
        "ink_coverage_permyriad",
        "render_width_pixels",
        "render_height_pixels"
      ],
      "type": "object"
    },
    "page": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "ready",
                  "needs_review"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "classification": {
                "enum": [
                  "blank",
                  "native_text",
                  "suspect_native",
                  "image_scan",
                  "mixed",
                  "degraded_photo"
                ]
              },
              "error": {
                "type": "null"
              },
              "metrics": {
                "$ref": "#/$defs/metrics"
              },
              "package_path": {
                "$ref": "#/$defs/relativePath"
              },
              "package_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "route": {
                "enum": [
                  "none",
                  "native",
                  "ocr",
                  "native_plus_ocr"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "classification": {
                "type": "null"
              },
              "error": {
                "$ref": "#/$defs/error"
              },
              "metrics": {
                "type": "null"
              },
              "package_path": {
                "type": "null"
              },
              "package_sha256": {
                "type": "null"
              },
              "route": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "oneOf": [
            {
              "$ref": "#/$defs/metrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "package_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "package_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_id": {
          "pattern": "^sha256:[0-9a-f]{64}:page:[0-9]{6}$",
          "type": "string"
        },
        "pdf_page": {
          "minimum": 1,
          "type": "integer"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "ready",
            "needs_review",
            "failed"
          ]
        }
      },
      "required": [
        "page_id",
        "pdf_page",
        "state",
        "classification",
        "route",
        "reason_codes",
        "metrics",
        "package_path",
        "package_sha256",
        "error"
      ],
      "type": "object"
    },
    "pageRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "not": {
        "pattern": "(^/|(^|/)\\.\\.?(/|$)|\\\\)"
      },
      "type": "string"
    },
    "routeCounts": {
      "additionalProperties": false,
      "properties": {
        "native": {
          "minimum": 0,
          "type": "integer"
        },
        "native_plus_ocr": {
          "minimum": 0,
          "type": "integer"
        },
        "none": {
          "minimum": 0,
          "type": "integer"
        },
        "ocr": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "none",
        "native",
        "ocr",
        "native_plus_ocr"
      ],
      "type": "object"
    },
    "selection": {
      "additionalProperties": false,
      "properties": {
        "catalog_keys": {
          "oneOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "page_ranges": {
          "items": {
            "$ref": "#/$defs/pageRange"
          },
          "type": "array"
        }
      },
      "required": [
        "catalog_keys",
        "page_ranges"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "classifications": {
          "$ref": "#/$defs/classificationCounts"
        },
        "documents_expected": {
          "minimum": 0,
          "type": "integer"
        },
        "documents_processed": {
          "minimum": 0,
          "type": "integer"
        },
        "pages_expected": {
          "minimum": 0,
          "type": "integer"
        },
        "pages_failed": {
          "minimum": 0,
          "type": "integer"
        },
        "pages_needs_review": {
          "minimum": 0,
          "type": "integer"
        },
        "pages_ready": {
          "minimum": 0,
          "type": "integer"
        },
        "routes": {
          "$ref": "#/$defs/routeCounts"
        }
      },
      "required": [
        "documents_expected",
        "documents_processed",
        "pages_expected",
        "pages_ready",
        "pages_needs_review",
        "pages_failed",
        "classifications",
        "routes"
      ],
      "type": "object"
    },
    "toolchain": {
      "additionalProperties": false,
      "properties": {
        "docling_parse": {
          "minLength": 1,
          "type": "string"
        },
        "paddle_cuda": {
          "type": "boolean"
        },
        "paddle_det_model": {
          "minLength": 1,
          "type": "string"
        },
        "paddle_device": {
          "minLength": 1,
          "type": "string"
        },
        "paddle_rec_model": {
          "minLength": 1,
          "type": "string"
        },
        "paddleocr": {
          "minLength": 1,
          "type": "string"
        },
        "paddlepaddle": {
          "minLength": 1,
          "type": "string"
        },
        "pillow": {
          "minLength": 1,
          "type": "string"
        },
        "pypdfium2": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "docling_parse",
        "pypdfium2",
        "pillow"
      ],
      "type": "object"
    }
  },
  "$id": "https://cadgpt.local/schemas/regulation-page-probe-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acquisition": {
      "$ref": "#/$defs/acquisitionIdentity"
    },
    "catalog": {
      "$ref": "#/$defs/catalogIdentity"
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/document"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    },
    "toolchain_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "schema_version",
    "catalog",
    "acquisition",
    "configuration",
    "toolchain",
    "toolchain_sha256",
    "selection",
    "documents",
    "summary"
  ],
  "type": "object"
}
