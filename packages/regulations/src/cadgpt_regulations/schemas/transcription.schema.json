{
  "$defs": {
    "bundleReference": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "minLength": 1,
          "type": "string"
        },
        "end_pdf_page": {
          "minimum": 1,
          "type": "integer"
        },
        "input_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "page_count": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "start_pdf_page": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "bundle_id",
        "sequence",
        "start_pdf_page",
        "end_pdf_page",
        "page_count",
        "input_bytes",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "configuration": {
      "additionalProperties": false,
      "properties": {
        "bundle_max_bytes": {
          "minimum": 1024,
          "type": "integer"
        },
        "bundle_max_pages": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "model_jpeg_quality": {
          "maximum": 95,
          "minimum": 30,
          "type": "integer"
        },
        "model_max_edge": {
          "maximum": 4096,
          "minimum": 320,
          "type": "integer"
        },
        "normalization_version": {
          "const": "1.0.0"
        },
        "ocr_critical_review_confidence_permyriad": {
          "const": 7500
        },
        "ocr_dense_fallback_psm": {
          "const": 6
        },
        "ocr_engine": {
          "const": "paddleocr"
        },
        "ocr_general_review_confidence_permyriad": {
          "const": 6000
        },
        "ocr_languages": {
          "const": [
            "fas",
            "eng"
          ]
        },
        "ocr_primary_psm": {
          "const": 3
        },
        "ocr_timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        },
        "paddle_det_model": {
          "minLength": 1,
          "type": "string"
        },
        "paddle_device": {
          "minLength": 1,
          "type": "string"
        },
        "paddle_rec_model": {
          "minLength": 1,
          "type": "string"
        },
        "paddle_text_det_limit_side_len": {
          "minimum": 1,
          "type": "integer"
        },
        "paddle_text_recognition_batch_size": {
          "minimum": 1,
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "normalization_version",
        "ocr_timeout_seconds",
        "ocr_languages",
        "ocr_primary_psm",
        "ocr_dense_fallback_psm",
        "ocr_general_review_confidence_permyriad",
        "ocr_critical_review_confidence_permyriad",
        "bundle_max_pages",
        "bundle_max_bytes",
        "model_max_edge",
        "model_jpeg_quality",
        "sha256"
      ],
      "type": "object"
    },
    "document": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "$ref": "#/$defs/relativePath"
        },
        "bundles": {
          "items": {
            "$ref": "#/$defs/bundleReference"
          },
          "type": "array"
        },
        "catalog_key": {
          "minLength": 1,
          "type": "string"
        },
        "catalog_order": {
          "minimum": 1,
          "type": "integer"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/page"
          },
          "type": "array"
        },
        "pdf_page_count": {
          "minimum": 1,
          "type": "integer"
        },
        "source_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "catalog_key",
        "catalog_order",
        "source_sha256",
        "source_bytes",
        "pdf_page_count",
        "artifact_path",
        "pages",
        "bundles"
      ],
      "type": "object"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "diagnostic": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "diagnostic"
      ],
      "type": "object"
    },
    "nullablePath": {
      "oneOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "page": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_input_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "normalized_chars": {
          "minimum": 0,
          "type": "integer"
        },
        "normalized_sha256": {
          "$ref": "#/$defs/nullableSha"
        },
        "package_path": {
          "$ref": "#/$defs/nullablePath"
        },
        "package_sha256": {
          "$ref": "#/$defs/nullableSha"
        },
        "page_id": {
          "pattern": "^sha256:[0-9a-f]{64}:page:[0-9]{6}$",
          "type": "string"
        },
        "pdf_page": {
          "minimum": 1,
          "type": "integer"
        },
        "printed_page_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "ready",
            "needs_review",
            "failed"
          ]
        }
      },
      "required": [
        "page_id",
        "pdf_page",
        "state",
        "classification",
        "route",
        "reason_codes",
        "printed_page_label",
        "package_path",
        "package_sha256",
        "normalized_sha256",
        "normalized_chars",
        "model_input_bytes",
        "error"
      ],
      "type": "object"
    },
    "probe": {
      "additionalProperties": false,
      "properties": {
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "toolchain_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "sha256",
        "configuration_sha256",
        "toolchain_sha256"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "not": {
        "pattern": "(^/|(^|/)\\.\\.?(/|$)|\\\\)"
      },
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "bundles": {
          "minimum": 0,
          "type": "integer"
        },
        "documents_expected": {
          "minimum": 0,
          "type": "integer"
        },
        "documents_processed": {
          "minimum": 0,
          "type": "integer"
        },
        "ocr_pages": {
          "minimum": 0,
          "type": "integer"
        },
        "pages_expected": {
          "minimum": 0,
          "type": "integer"
        },
        "pages_failed": {
          "minimum": 0,
          "type": "integer"
        },
        "pages_needs_review": {
          "minimum": 0,
          "type": "integer"
        },
        "pages_ready": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "documents_expected",
        "documents_processed",
        "pages_expected",
        "pages_ready",
        "pages_needs_review",
        "pages_failed",
        "ocr_pages",
        "bundles"
      ],
      "type": "object"
    }
  },
  "$id": "https://cadgpt.local/schemas/regulation-transcription-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acquisition": {
      "type": "object"
    },
    "catalog": {
      "type": "object"
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/document"
      },
      "type": "array"
    },
    "ocr_toolchain": {
      "type": [
        "object",
        "null"
      ]
    },
    "probe": {
      "$ref": "#/$defs/probe"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "required": [
    "schema_version",
    "catalog",
    "acquisition",
    "probe",
    "configuration",
    "ocr_toolchain",
    "documents",
    "summary"
  ],
  "type": "object"
}
