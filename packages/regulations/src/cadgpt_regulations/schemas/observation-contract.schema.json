{
  "$id": "https://cadgpt.local/schemas/observation-contract-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": ["schema_version", "record_id", "status", "reason_code", "source_citation_sha256", "source_citation", "rule", "required_observations"],
  "properties": {
    "schema_version": {"const": "observation-contract-1.0.0"},
    "record_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "DEFERRED"},
    "reason_code": {"const": "REQUIRES_DERIVED_OBSERVATIONS"},
    "source_citation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_citation": {"type": "object", "minProperties": 1},
    "rule": {"type": "object", "minProperties": 1},
    "required_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_key", "kind", "status", "unit"],
        "properties": {
          "observation_key": {"type": "string", "minLength": 1},
          "kind": {"enum": ["geometry", "formula", "table", "numeric", "text", "boolean"]},
          "status": {"const": "PENDING"},
          "unit": {"type": ["string", "null"]}
        }
      }
    }
  }
}
