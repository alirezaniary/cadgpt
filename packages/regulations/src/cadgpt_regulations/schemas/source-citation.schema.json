{
  "$id": "https://cadgpt.local/schemas/source-citation-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "book_title_fa": {"minLength": 1, "type": "string"},
    "citation_status": {"const": "verified"},
    "document_key": {"minLength": 1, "type": "string"},
    "document_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "edition_fa": {"minLength": 1, "type": "string"},
    "exact_text_fa": {"minLength": 1, "type": "string"},
    "exact_text_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "pdf_page": {"minimum": 1, "type": "integer"},
    "page_id": {"minLength": 1, "type": ["string", "null"]},
    "printed_page_label": {"minLength": 1, "type": ["string", "null"]},
    "qualifier_text_fa": {"type": ["string", "null"]},
    "source_node_ids": {
      "items": {"minLength": 1, "type": "string"},
      "uniqueItems": true,
      "type": "array"
    },
    "source_span_ids": {
      "items": {"minLength": 1, "type": "string"},
      "uniqueItems": true,
      "type": "array"
    },
    "evidence_kind": {"enum": ["source_graph", "transcript"]},
    "transcript_revision_id": {"type": ["string", "null"]},
    "transcript_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]}
  },
  "required": [
    "document_key", "book_title_fa", "edition_fa", "document_sha256", "pdf_page",
    "exact_text_fa",
    "exact_text_sha256", "qualifier_text_fa", "citation_status"
  ],
  "type": "object"
}
