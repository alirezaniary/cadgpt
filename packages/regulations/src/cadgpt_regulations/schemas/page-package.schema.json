{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "application/json",
            "image/png"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "role": {
          "enum": [
            "native_layout",
            "source_render"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "role",
        "path",
        "sha256",
        "bytes",
        "media_type"
      ],
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "bitmap_count": {
          "minimum": 0,
          "type": "integer"
        },
        "bitmap_coverage_permyriad": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "ink_coverage_permyriad": {
          "oneOf": [
            {"maximum": 10000, "minimum": 0, "type": "integer"},
            {"type": "null"}
          ]
        },
        "native_char_cells": {
          "minimum": 0,
          "type": "integer"
        },
        "native_line_cells": {
          "minimum": 0,
          "type": "integer"
        },
        "native_nonspace_chars": {
          "minimum": 0,
          "type": "integer"
        },
        "native_word_cells": {
          "minimum": 0,
          "type": "integer"
        },
        "render_height_pixels": {
          "oneOf": [{"minimum": 1, "type": "integer"}, {"type": "null"}]
        },
        "render_width_pixels": {
          "oneOf": [{"minimum": 1, "type": "integer"}, {"type": "null"}]
        },
        "shape_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "native_char_cells",
        "native_nonspace_chars",
        "native_word_cells",
        "native_line_cells",
        "bitmap_count",
        "shape_count",
        "bitmap_coverage_permyriad",
        "ink_coverage_permyriad",
        "render_width_pixels",
        "render_height_pixels"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "not": {
        "pattern": "(^/|(^|/)\\.\\.?(/|$)|\\\\)"
      },
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "catalog_key": {
          "minLength": 1,
          "type": "string"
        },
        "catalog_order": {
          "minimum": 1,
          "type": "integer"
        },
        "pdf_page": {
          "minimum": 1,
          "type": "integer"
        },
        "pdf_page_count": {
          "minimum": 1,
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "catalog_key",
        "catalog_order",
        "sha256",
        "bytes",
        "pdf_page_count",
        "pdf_page"
      ],
      "type": "object"
    },
    "toolchain": {
      "additionalProperties": false,
      "properties": {
        "docling_parse": {
          "minLength": 1,
          "type": "string"
        },
        "paddle_cuda": {
          "type": "boolean"
        },
        "paddle_det_model": {
          "minLength": 1,
          "type": "string"
        },
        "paddle_device": {
          "minLength": 1,
          "type": "string"
        },
        "paddle_rec_model": {
          "minLength": 1,
          "type": "string"
        },
        "paddleocr": {
          "minLength": 1,
          "type": "string"
        },
        "paddlepaddle": {
          "minLength": 1,
          "type": "string"
        },
        "pillow": {
          "minLength": 1,
          "type": "string"
        },
        "pypdfium2": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "docling_parse",
        "pypdfium2",
        "pillow"
      ],
      "type": "object"
    }
  },
  "$id": "https://cadgpt.local/schemas/regulation-page-package-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
    },
    "classification": {
      "enum": [
        "blank",
        "native_text",
        "suspect_native",
        "image_scan",
        "mixed",
        "degraded_photo"
      ]
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "error": {
      "type": "null"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "page_id": {
      "pattern": "^sha256:[0-9a-f]{64}:page:[0-9]{6}$",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "route": {
      "enum": [
        "none",
        "native",
        "ocr",
        "native_plus_ocr"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "state": {
      "enum": [
        "ready",
        "needs_review"
      ]
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    },
    "toolchain_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "schema_version",
    "page_id",
    "source",
    "configuration_sha256",
    "toolchain",
    "toolchain_sha256",
    "state",
    "classification",
    "route",
    "reason_codes",
    "metrics",
    "artifacts",
    "error"
  ],
  "type": "object"
}
