{
  "$id": "https://cadgpt.local/schemas/deferred-rule-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "status",
    "reason_code",
    "source_citation_sha256",
    "source_citation",
    "original_rule"
  ],
  "properties": {
    "schema_version": {"const": "rule-capability-1.0.0"},
    "record_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "deferred"},
    "reason_code": {"type": "string", "minLength": 1},
    "source_citation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_citation": {"type": "object", "minProperties": 1},
    "original_rule": {"type": "object", "minProperties": 1}
  }
}
